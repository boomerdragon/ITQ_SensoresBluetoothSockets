<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#001A33">

    <!-- Encabezado Arcade HUD -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textColor="#FF6600"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Tarjeta de Acelerómetro -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#002244"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accelerometer"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValoresAcelerometro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accelerometer_values"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvMagnitudAcelerometro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accelerometer_magnitude"
                android:textColor="#FFD700"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tarjeta de Giroscopio -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#002244"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/giroscopio"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvValoresGiroscopio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/accelerometer_values"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Estado del Servidor P2P -->
    <TextView
        android:id="@+id/tvEstadoServidor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/estado_p2p"
        android:textColor="#FF6600"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Estado del Servidor Web HTTP -->
    <TextView
        android:id="@+id/tvEstadoServidorWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/estado_servidor_web"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Estado del Servidor Bluetooth SPP -->
    <TextView
        android:id="@+id/tvEstadoBluetooth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/estado_bluetooth"
        android:textColor="#FFD700"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Botón de Transmisión Telegráfica P2P TCP -->
    <Button
        android:id="@+id/btnEnviarP2P"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/inertial_reading_p2p"
        android:backgroundTint="#FF6600"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="6dp" />

    <!-- Botón de Transmisión Bluetooth SPP -->
    <Button
        android:id="@+id/btnEnviarBluetooth"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/transmit_bluetooth"
        android:backgroundTint="#00E5FF"
        android:textColor="#001A33"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        android:layout_marginBottom="10dp" />

    <!-- Lista RecyclerView de Paquetes P2P -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensajesP2P"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>